{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strawlink/village_forecast.schema.json",
  "title": "village_forecast.json",
  "version": "0.1",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["village_id", "issued_on", "week_start", "tonnes_p10", "tonnes_p50", "tonnes_p90"],
    "properties": {
      "village_id": {"type": "string"},
      "issued_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
      "week_start": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
      "tonnes_p10": {"type": "number", "minimum": 0},
      "tonnes_p50": {"type": "number", "minimum": 0},
      "tonnes_p90": {"type": "number", "minimum": 0},
      "synthetic": {"type": "boolean"}
    },
    "additionalProperties": false
  }
}
