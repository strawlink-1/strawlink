{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strawlink/field_series.schema.json",
  "title": "field_series.parquet (rows; JSON example is an array of rows)",
  "version": "0.1",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["field_id", "date", "sensor", "ndvi", "nbr", "cloud_frac", "n_pixels"],
    "properties": {
      "field_id": {"type": "string"},
      "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
      "sensor": {"enum": ["S2", "L8", "L9", "S1"]},
      "ndvi": {"type": ["number", "null"], "minimum": -1, "maximum": 1},
      "nbr": {"type": ["number", "null"], "minimum": -1, "maximum": 1},
      "cloud_frac": {"type": "number", "minimum": 0, "maximum": 1},
      "n_pixels": {"type": "integer", "minimum": 0},
      "synthetic": {"type": "boolean"}
    },
    "additionalProperties": false
  }
}
