{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strawlink/forecast.schema.json",
  "title": "forecast.json / forecast.parquet rows",
  "version": "0.1",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["field_id", "issued_on", "p10", "p50", "p90", "source", "confidence"],
    "properties": {
      "field_id": {"type": "string"},
      "issued_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
      "p10": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
      "p50": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
      "p90": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
      "source": {"enum": ["satellite", "confirmed"]},
      "confidence": {"type": "number", "minimum": 0, "maximum": 1},
      "synthetic": {"type": "boolean"}
    },
    "additionalProperties": false
  }
}
